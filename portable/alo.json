and(
  equals(
    body('RespostaCartao')?['data']?['acao'],
    'confirmarRevogacao'
  ),
  equals(
    body('RespostaCartao')?['data']?['todosGruposRevogados'],
    'true'
  ),
  equals(
    body('ObterAcessoAtual')?['StatusControle']?['Value'],
    'Pendente'
  ),
  empty(
    body('ObterAcessoAtual')?['RevogacaoConfirmadaEm']
  ),
  equals(
    body('ObterAcessoAtual')?['FimAcesso'],
    triggerBody()?['FimAcesso']
  ),
  equals(
    string(body('ObterAcessoAtual')?['GruposAcesso']),
    string(triggerBody()?['GruposAcesso'])
  ),
  equals(
    body('ObterAcessoAtual')?['Title'],
    triggerBody()?['Title']
  ),
  equals(
    body('ObterAcessoAtual')?['NomePessoa'],
    triggerBody()?['NomePessoa']
  )
)
