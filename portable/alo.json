If(
    IsBlank(Form1.Updates.InicioAcesso) ||
    IsBlank(Form1.Updates.FimAcesso);
    Notify(
        "Preencha a data e o horário de início e término.";
        NotificationType.Error
    );

    Form1.Updates.FimAcesso <= Form1.Updates.InicioAcesso;
    Notify(
        "O término do acesso deve ser posterior ao início.";
        NotificationType.Error
    );

    Form1.Mode = FormMode.New;
    SubmitForm(Form1);

    Form1.Mode = FormMode.Edit;
    With(
        {
            registroAtual: IfError(
                LookUp(
                    'Controle de Acessos Temporários - Data Center';
                    ID = Form1.Item.ID
                );
                Blank()
            )
        };
        If(
            IsBlank(registroAtual.ID);
            Notify(
                "Não foi possível consultar o cadastro. Tente novamente.";
                NotificationType.Error
            );

            registroAtual.StatusControle.Value <> "Pendente" ||
            !IsBlank(registroAtual.RevogacaoConfirmadaEm);
            Notify(
                "Este cadastro já foi cancelado ou revogado. As alterações não foram salvas. Saia da edição e atualize os dados.";
                NotificationType.Warning
            );

            SubmitForm(Form1)
        )
    )
)
